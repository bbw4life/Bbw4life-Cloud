# ─────────────────────────────────────────────
# BBW4LIFE — Netlify _headers
# Force l'indexation sur toutes les pages publiques
# et bloque l'indexation des pages privées (compte, checkout)
# ─────────────────────────────────────────────

# Toutes les pages par défaut : indexables
/*
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Pages privées / sans intérêt SEO : noindex explicite
/account*
  X-Robots-Tag: noindex, nofollow

/checkout/*
  X-Robots-Tag: noindex, nofollow

/cart*
  X-Robots-Tag: noindex, nofollow

# ─────────────────────────────────────────────
# CACHE — no-store interdit TOUTE mise en cache (navigateur + intermédiaires),
# pas seulement une revalidation optionnelle : chaque requête retélécharge le
# fichier depuis Cloudflare, garantissant que la dernière version déployée
# s'affiche automatiquement après un simple refresh, sans purge manuelle.
#
# Équivalent Cloudflare Pages des [[headers]] par EXTENSION du netlify.toml
# d'origine (/*.html, /*.js, /*.css) — Cloudflare Pages ne supporte pas le
# matching par extension dans _headers (uniquement des préfixes de chemin,
# un seul splat "*" par règle), donc reproduit ici par préfixe de dossier :
# la racine du site, puis chaque sous-dossier public connu.
# ─────────────────────────────────────────────

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/*.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/*.css
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/products.data.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/products/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/blog/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/collections/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/page/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/policies/*
